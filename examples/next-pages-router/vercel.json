{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile --filter example-next-pages-router...",
  "buildCommand": "pnpm --filter \"example-next-pages-router^...\" build && pnpm run build",
  "ignoreCommand": "[ \"$VERCEL_ENV\" = \"production\" ] && exit 1 || exit 0",
  "redirects": [
    {
      "source": "/",
      "destination": "/shop",
      "permanent": false
    }
  ]
}
