{
  "name": "@next-federation/core",
  "version": "0.1.0",
  "description": "defineFederation: validated host config, remote registry and event API for next-federation.",
  "license": "MIT",
  "author": "tariqule",
  "homepage": "https://github.com/tariqule/next-federation#readme",
  "bugs": "https://github.com/tariqule/next-federation/issues",
  "keywords": [
    "module-federation",
    "nextjs",
    "react-server-components",
    "micro-frontends",
    "islands",
    "federation-config",
    "identity"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tariqule/next-federation.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "default": "./dist/identity/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@next-federation/protocol": "workspace:*",
    "@next-federation/sdk": "workspace:*",
    "jose": "^6.2.17"
  },
  "scripts": {
    "build": "tsdown"
  }
}
