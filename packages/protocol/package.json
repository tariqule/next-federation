{
  "name": "@next-federation/protocol",
  "version": "0.1.2",
  "description": "The bundler-neutral wire contract of next-federation: island envelope, request codec, bootstrap types and the remote components descriptor.",
  "license": "MIT",
  "author": "tariqule",
  "homepage": "https://next-federation-docs.vercel.app/docs/api/protocol",
  "bugs": "https://github.com/tariqule/next-federation/issues",
  "keywords": [
    "nextjs",
    "next.js",
    "micro-frontends",
    "microfrontends",
    "module-federation",
    "react-server-components",
    "rsc",
    "app-router",
    "islands",
    "protocol",
    "rsc-flight"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tariqule/next-federation.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@next-federation/sdk": "workspace:*"
  },
  "scripts": {
    "build": "tsdown"
  }
}
