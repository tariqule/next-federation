  "description": "Category logger and NF-xxx error codes shared by every next-federation package.",
  "license": "MIT",
  "author": "tariqule",
  "homepage": "https://github.com/tariqule/next-federation#readme",
  "bugs": "https://github.com/tariqule/next-federation/issues",
