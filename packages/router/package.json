{
  "name": "@next-federation/router",
  "version": "0.2.1",
  "description": "Internal plumbing for next-federation: the router shims remote builds rewire their links to, and the host router modules. Not for direct import (only its ./build helpers go in a remote's config).",
  "license": "MIT",
  "author": "tariqule",
  "homepage": "https://next-federation-docs.vercel.app/docs/api/router",
  "bugs": "https://github.com/tariqule/next-federation/issues",
  "keywords": [
    "nextjs",
    "next.js",
    "micro-frontends",
    "microfrontends",
    "module-federation",
    "router",
    "react-router",
    "link",
    "navigation"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tariqule/next-federation.git",
    "directory": "packages/router"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "default": "./dist/react-router.js"
    },
    "./host-navigation": {
      "types": "./dist/host-navigation.d.ts",
      "default": "./dist/host-navigation.js"
    },
    "./next-host": {
      "types": "./dist/next-host.d.ts",
      "default": "./dist/next-host.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./shims/next-link": {
      "types": "./dist/shims/next-link.d.ts",
      "default": "./dist/shims/next-link.js"
    },
    "./shims/next-navigation": {
      "types": "./dist/shims/next-navigation.d.ts",
      "default": "./dist/shims/next-navigation.js"
    },
    "./shims/react-router": {
      "types": "./dist/shims/react-router.d.ts",
      "default": "./dist/shims/react-router.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-router": ">=7.0.0 <8"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6"
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    }
  }
}
