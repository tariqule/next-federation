{
  "name": "@next-federation/vite",
  "version": "0.1.2",
  "description": "Vite plugins that build next-federation island remotes and Module Federation 2.0 remote components remotes.",
  "license": "MIT",
  "author": "tariqule",
  "homepage": "https://next-federation-docs.vercel.app/docs/api/vite",
  "bugs": "https://github.com/tariqule/next-federation/issues",
  "keywords": [
    "nextjs",
    "next.js",
    "micro-frontends",
    "microfrontends",
    "module-federation",
    "react-server-components",
    "rsc",
    "app-router",
    "islands",
    "vite",
    "vite-plugin",
    "vite-plugin-rsc"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tariqule/next-federation.git",
    "directory": "packages/vite"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@module-federation/vite": "1.24.0",
    "@next-federation/island": "workspace:*",
    "@next-federation/protocol": "workspace:*",
    "@next-federation/router": "workspace:*",
    "@next-federation/sdk": "workspace:*",
    "@next-federation/server": "workspace:*",
    "@vitejs/plugin-rsc": "0.5.39",
    "jose": "^6.2.17"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "~19.0.9 || ~19.1.10 || ~19.2.9 || >=19.3.1 <20",
    "typescript": ">=5.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react-server-dom-webpack": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@next-federation/core": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vite": "8.3.8"
  }
}
