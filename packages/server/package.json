{
  "name": "@next-federation/server",
  "version": "0.1.1",
  "description": "Server runtime for next-federation island remotes: the island request handler, identity verification, HTML cleanup and the nf-serve build server.",
  "license": "MIT",
  "author": "tariqule",
  "homepage": "https://next-federation-docs.vercel.app/docs/api/server",
  "bugs": "https://github.com/tariqule/next-federation/issues",
  "keywords": [
    "nextjs",
    "next.js",
    "micro-frontends",
    "microfrontends",
    "module-federation",
    "react-server-components",
    "rsc",
    "app-router",
    "islands",
    "ssr",
    "nf-serve",
    "server-actions"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tariqule/next-federation.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@next-federation/protocol": "workspace:*",
    "@next-federation/sdk": "workspace:*",
    "jose": "^6.2.17",
    "parse5": "8.1.1"
  },
  "devDependencies": {
    "@next-federation/core": "workspace:*"
  },
  "bin": {
    "nf-describe": "./dist/node/describe-cli.js",
    "nf-serve": "./dist/node/cli.js"
  }
}
