{
  "name": "@next-federation/react",
  "version": "0.0.0",
  "description": "React components for next-federation: the island mount, the island error boundary and fallbacks.",
  "license": "MIT",
  "author": "tariqule",
  "homepage": "https://github.com/tariqule/next-federation#readme",
  "bugs": "https://github.com/tariqule/next-federation/issues",
  "keywords": [
    "module-federation",
    "nextjs",
    "react-server-components",
    "micro-frontends",
    "islands",
    "react",
    "error-boundary"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tariqule/next-federation.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./share": {
      "types": "./dist/provide-host-react.d.ts",
      "default": "./dist/provide-host-react.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components/server-loader": {
      "types": "./dist/components/server-loader.d.ts",
      "browser": "./dist/components/server-loader.browser.js",
      "node": "./dist/components/server-loader.js",
      "default": "./dist/components/server-loader.browser.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@module-federation/runtime": "2.9.3",
    "@next-federation/protocol": "workspace:*",
    "@next-federation/sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "scripts": {
    "build": "tsdown"
  }
}
