{
  "name": "next-federation-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "e2e": "pnpm --filter e2e test",
    "e2e:webpack": "NF_BUNDLER=webpack pnpm --filter e2e test",
    "test": "pnpm -r --filter=!e2e --if-present test",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"spike/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "eslint": "9.39.3",
    "prettier": "3.8.1",
    "typescript": "6.0.3"
  }
}
