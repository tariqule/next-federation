{
  "name": "next-federation-workspace",
  "private": true,
  "description": "Monorepo for next-federation, runtime UI federation for Next.js.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "rstest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:docs": "alex README.md AGENTS.md docs",
    "guardrail": "node scripts/check-guardrails.mjs",
    "check:error-docs": "node scripts/check-error-docs.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "e2e": "pnpm e2e:dev && pnpm e2e:dev:webpack && pnpm e2e:prod && pnpm e2e:prod:webpack && pnpm e2e:skew && pnpm e2e:installed && pnpm e2e:installed:webpack",
    "e2e:dev": "NF_MODE=dev pnpm --filter e2e test",
    "e2e:dev:webpack": "NF_MODE=dev NF_BUNDLER=webpack pnpm --filter e2e test",
    "e2e:prod": "NF_MODE=prod pnpm --filter e2e test",
    "e2e:prod:webpack": "NF_MODE=prod NF_BUNDLER=webpack pnpm --filter e2e test",
    "e2e:skew": "NF_MODE=prod NF_SUITE=skew pnpm --filter e2e test",
    "e2e:installed": "NF_MIN_PASSED=4 NF_MODE=dev NF_SUITE=installed NF_APPS=remote-a,host-installed-15,host-installed-16,host-installed-15-no-source-maps,host-installed-16-no-source-maps pnpm --filter e2e test -- installed-dev",
    "e2e:installed:webpack": "NF_MIN_PASSED=4 NF_MODE=dev NF_BUNDLER=webpack NF_SUITE=installed NF_APPS=remote-a,host-installed-15,host-installed-16,host-installed-15-no-source-maps,host-installed-16-no-source-maps pnpm --filter e2e test -- installed-dev",
    "e2e:browsers": "NF_BROWSERS=all pnpm e2e:prod",
    "examples:keys": "node examples/scripts/keys.mjs",
    "examples:demo-keys": "node examples/scripts/demo-keys.mjs",
    "examples:dev": "node examples/scripts/run.mjs dev",
    "examples:start": "node examples/scripts/run.mjs start",
    "examples:smoke": "node examples/scripts/run.mjs smoke",
    "examples:walkthrough": "node examples/scripts/walkthrough.mjs",
    "examples:platform": "node examples/scripts/platform.mjs start",
    "examples:platform:dev": "node examples/scripts/platform.mjs dev",
    "examples:platform:smoke": "node examples/scripts/platform.mjs smoke",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^19.4.1",
    "@rstest/core": "0.10.6",
    "@types/node": "24.10.1",
    "alex": "11.0.1",
    "eslint": "9.39.3",
    "happy-dom": "21.0.4",
    "pkg-pr-new": "0.0.93",
    "prettier": "3.8.1",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "8.5.32",
      "minimatch@>=7 <11.0.1": "11.0.1",
      "glob@>=9 <14.0.2": "14.0.2"
    }
  }
}
