{
  "name": "island-remote",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "serve:prod": "vite build && vite preview --host 127.0.0.1 --strictPort",
    "serve:skew": "rm -rf dist/a-versions && NF_VERSIONED=1 NF_BUILD_ID=v1 vite build && NF_VERSIONED=1 NF_BUILD_ID=v2 vite build && NODE_ENV=production node serve-versions.ts"
  },
  "dependencies": {
    "@nf-spike/proto": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "server-only": "0.0.1",
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
